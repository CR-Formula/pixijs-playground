{
  "name": "pixijs-playground",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start --host 0.0.0.0",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "dev:server": "nodemon --watch src --exec ts-node src/server.ts",
    "build:server": "tsc -p tsconfig.json",
    "start:server": "node dist/server.js --host 0.0.0.0",
    "dev:all": "concurrently \"npm:start\" \"npm:dev:server\""
  },
  "dependencies": {
    "@docusaurus/core": "3.2.1",
    "@docusaurus/preset-classic": "3.2.1",
    "@mdx-js/react": "^3.0.0",
    "@serialport/parser-readline": "^13.0.0",
    "@types/w3c-web-serial": "^1.0.3",
    "browser-serial": "^1.0.7",
    "clsx": "^2.0.0",
    "pixi.js": "^8.15.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-syntax-highlighter": "^15.5.0",
    "serialport": "^13.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "web-serial-polyfill": "^1.0.14"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.2.1",
    "@docusaurus/tsconfig": "3.2.1",
    "@docusaurus/types": "3.2.1",
    "@types/dom-serial": "^1.0.6",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11",
    "raw-loader": "^4.0.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.2.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
